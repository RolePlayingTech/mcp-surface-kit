{
  "name": "mcp-surface-kit",
  "version": "1.1.0",
  "description": "Record, explain and check an MCP tool surface: tiers, prepare/confirm pairs, skills and scopes.",
  "type": "module",
  "bin": {
    "mcp-surface": "./bin/mcp-surface.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "node --test tests/check.test.mjs tests/build.test.mjs tests/cli.test.mjs",
    "check": "node bin/mcp-surface.mjs check examples/content-workspace --strict",
    "explain": "node bin/mcp-surface.mjs explain examples/content-workspace",
    "build:dry-run": "node bin/mcp-surface.mjs build examples/content-workspace --dry-run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "prepare-confirm",
    "tool-surface"
  ],
  "author": "RolePlayingTech (MUMRO Academy, https://academy.mumro.io)",
  "license": "MIT",
  "homepage": "https://github.com/RolePlayingTech/mcp-surface-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RolePlayingTech/mcp-surface-kit.git"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
